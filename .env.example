# ==============================================================================
# SprintStack.digital - Environment Configuration Template
# Copy this file to .env.local for local development
# Do NOT commit real secrets or production credentials to Git
# ==============================================================================

# Site & Domain
NEXT_PUBLIC_SITE_URL=https://sprintstack.digital

# Analytics (Google Analytics 4)
NEXT_PUBLIC_GA_ID=

# Supabase (PostgreSQL Lead Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend (Transactional Email Notifications)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=engineering@sprintstack.digital
NOTIFICATION_EMAIL=leads@sprintstack.digital

# Calendar & Technical Discovery Booking Integration (Cal.com / Calendly)
# If left empty, the website cleanly directs users to the Architecture & Sprint Plan form
BOOKING_URL=https://cal.com/sprintstack/discovery-15min

# Optional Integrations: Slack / CRM Webhook Dispatch
SLACK_WEBHOOK_URL=

# Optional: Cloudflare Turnstile Anti-Spam Protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
